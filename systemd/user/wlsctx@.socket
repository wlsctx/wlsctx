# Socket-activated half of wlsctx deployment mode A (see the headers of
# wlsctx@.container and wl-display@.container for the two modes).
#
# The tagged Wayland socket lives in the host's XDG_RUNTIME_DIR
# (wlsctx/%i/wayland-1). FileDescriptorName=%i is only a label; wlsctx no
# longer derives app/instance IDs from it — set WLSCTX_APP_ID and
# WLSCTX_INSTANCE_ID before starting wlsctx@<instance>.
[Unit]
Description=Wayland socket with security context attached (%i)
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=wayland-session-shutdown.target
Before=wayland-session-shutdown.target
PropagatesStopTo=%N.service

[Socket]
RuntimeDirectory=wlsctx/%i
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
SocketMode=0600
ListenStream=%t/wlsctx/%i/wayland-1
FileDescriptorName=%i
PassCredentials=yes

[Install]
WantedBy=%i.target
