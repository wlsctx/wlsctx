(type wlsctx_exec_t)
(roletype object_r wlsctx_exec_t)
(type wlsctx_t)
(roletype object_r wlsctx_t)
(roletype unconfined_r wlsctx_t)
(type wlsctx_app_t)
(roletype object_r wlsctx_app_t)
(roletype unconfined_r wlsctx_app_t)
; decision #42: the pdeathsig-restore shim (.so) type. A confined
; consumer must *map it with PROT_EXEC* — on this kernel a PROT_EXEC
; mapping needs `file:execute` (file_map_prot_to_av), which no
; base-policy type grants to `wlsctx_app_t`/`xserver_t` on a file in
; the instance runtime dir. Dedicated type, NOT a member of `lib_t`
; (which every app type can read): the two consumer types below get
; the grants, nothing else can touch it. `ensure_shim` relabels the
; compiled `.so` to it with setxattr (on this kernel `filecon`
; statements do not label created inodes and their contexts are not
; pre-registered in the sidtab — the sidtab expands on demand).
(type wlsctx_shim_t)
(roletype object_r wlsctx_shim_t)
