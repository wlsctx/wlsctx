(typeattributeset mcs_constrained_type (wlsctx_t wlsctx_app_t))
; this kernel's process class splits `signal` into signull (kill 0),
; sigkill and signal. The base policy's mlsconstrain list constrains
; ptrace/signal/sigkill/sigstop — but NOT signull. A module CIL cannot
; add an mlsconstrain rule (the libsepol CIL reader rejects it:
; "Bad constrain declaration"), so the signull grants in the process
; allow rules below (terminate_app's kill -0 liveness probe, and
; strace-style tools) stay *unconstrained* by MCS: any cN wlsctx
; subject may kill -0 any wlsctx process, including another
; instance's. That is a documented limitation of the module-based
; approach, not a bug — see LESSONS #33.
(allow unconfined_t wlsctx_exec_t (file (entrypoint execute getattr map open read)))
; installing / updating the binary (sudo from the user shell; cp
; probes the target with an ioctl, the update writes it)
(allow unconfined_t wlsctx_exec_t (file (write setattr relabelfrom relabelto ioctl)))
; the user can signal wlsctx processes (stop / cleanup of runs;
; kill -9 needs the explicit sigkill, strace probes with signull)
(allow unconfined_t wlsctx_t (process (getattr noatsecure rlimitinh siginh transition signal sigkill signull)))
; external clients (the compositor, `wlsctx decide` from other
; shells, tools) connect to wlsctx's sockets; data then flows both
; ways between the two sockets
; userspace tools (ls, cat) inspecting wlsctx's /proc entries
(allow unconfined_t wlsctx_t (lnk_file (getattr read)))
; strace probing wlsctx process fds
(allow unconfined_t wlsctx_t (unix_stream_socket (getattr)))
(allow unconfined_t wlsctx_t (unix_stream_socket (connectto read write)))
; the user can trace wlsctx processes (strace/gdb while iterating on them:
; the kernel re-checks the tracer's ptrace permission on the *new* context
; at every SID-changing exec, so without this even `strace wlsctx --help`
; dies with EPERM — selinux_bprm_creds_for_exec, LSM_UNSAFE_PTRACE)
(allow unconfined_t wlsctx_t (process (ptrace)))
(allow unconfined_t wlsctx_t (dir (getattr open read search)))
(allow unconfined_t wlsctx_t (file (getattr ioctl open read)))
; the user can signal the sandboxed app's host-visible process
; (signull: the kill -0 liveness probe, strace-style tools)
(allow unconfined_t wlsctx_app_t (process (getattr noatsecure rlimitinh siginh signal sigkill signull ptrace)))
(allow unconfined_t xserver_t (process (getattr noatsecure rlimitinh siginh signal sigkill signull ptrace)))
(allow unconfined_t wlsctx_app_t (dir (getattr open read search)))
(allow unconfined_t wlsctx_app_t (file (open read)))
(allow unconfined_t wlsctx_app_t (unix_stream_socket (read write)))
(allow unconfined_t wlsctx_t (dbus (send_msg)))
(allow unconfined_t wlsctx_app_t (dbus (send_msg)))
(typetransition unconfined_t wlsctx_exec_t process wlsctx_t)
(allow wlsctx_t wlsctx_app_t (process (transition dyntransition noatsecure)))
(typetransition wlsctx_t bin_t process wlsctx_app_t)
(typetransition wlsctx_t shell_exec_t process wlsctx_app_t)
(typetransition wlsctx_t user_home_t process wlsctx_app_t)
(allow wlsctx_app_t bin_t (process (noatsecure rlimitinh siginh)))
(allow wlsctx_app_t shell_exec_t (process (noatsecure rlimitinh siginh)))
(allow wlsctx_app_t user_home_t (process (noatsecure rlimitinh siginh)))
(allow wlsctx_app_t lib_t (process (noatsecure rlimitinh siginh)))
(allow wlsctx_app_t usr_t (process (noatsecure rlimitinh siginh)))
(allow wlsctx_t xserver_t (process (transition dyntransition)))
(typetransition wlsctx_t xserver_exec_t process xserver_t)
(allow wlsctx_t xserver_exec_t (file (entrypoint execute getattr map open read)))
(allow wlsctx_t wlsctx_exec_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow wlsctx_t wlsctx_t (process (dyntransition fork getattr getsched getsession getrlimit noatsecure ptrace rlimitinh setcurrent setexec setfscreate setkeycreate setpgid setsockcreate transition sigchld siginh signal sigkill signull sigstop)))
(allow wlsctx_t wlsctx_t (dir (search)))
(allow wlsctx_t wlsctx_t (file (append create getattr map open read unlink write)))
; listen(2) is checked against the socket's own context (the
; kernel's selinux_socket_listen → sock_has_perm), so a listener
; must be allowed to `listen` on its own sockets
(allow wlsctx_t wlsctx_t (unix_stream_socket (accept bind connect connectto create getattr read write getopt setopt listen)))
(allow wlsctx_t wlsctx_t (udp_socket (create getattr ioctl read write getopt setopt)))
(allow wlsctx_t wlsctx_t (fifo_file (read write)))
(allow wlsctx_t wlsctx_t (lnk_file (read)))
(allow wlsctx_t wlsctx_t (fd (use)))
; dac_override: B's mount of proc (and the fresh tmpfs / dev) is a
; capability-gated path lookup in the new userns — the kernel falls
; back to CAP_DAC_OVERRIDE (class cap_userns) when the mount-point
; check fails; without it the mount still succeeds (the app's uid
; matches the fresh-rootfs inodes) but a denial is logged every run
(allow wlsctx_t wlsctx_t (cap_userns (sys_admin sys_chroot sys_ptrace net_admin dac_override)))
(allow wlsctx_t wlsctx_t (user_namespace (create)))
(allow wlsctx_t file_type (filesystem (mount remount unmount transition)))
(allow wlsctx_t file_type (dir (mounton)))
(allow wlsctx_t tmp_t (dir (create getattr open search read write add_name remove_name rmdir mounton setattr)))
(allow wlsctx_t tmp_t (file (append create getattr map open read write unlink mounton)))
; `--listen /tmp/foo.sock`: a plain tmp socket
(allow wlsctx_t tmp_t (sock_file (create getattr open read write unlink)))
(allow wlsctx_t cgroup_t (dir (create getattr open search read write add_name remove_name rmdir)))
(allow wlsctx_t cgroup_t (file (getattr open read write)))
(allow wlsctx_t unconfined_t (system (start)))
(allow wlsctx_t unconfined_t (fd (use)))
; host-side wlsctx stdout/stderr go through shell-created pipes
; (the ioctl is the isatty probe)
(allow wlsctx_t unconfined_t (fifo_file (read write ioctl)))
; replies to those external clients
(allow wlsctx_t unconfined_t (unix_stream_socket (read write)))
(allow wlsctx_t unconfined_t (dbus (send_msg)))
; S supervises the app: the courtesy TERM, the kill -0 liveness
; probe (terminate_app) and the SIGKILL escalation
(allow wlsctx_t wlsctx_app_t (process (getattr noatsecure ptrace rlimitinh sigkill siginh signull signal)))
(allow wlsctx_t wlsctx_app_t (process2 (nnp_transition)))
(allow wlsctx_t wlsctx_app_t (dir (search)))
(allow wlsctx_t wlsctx_app_t (file (open read)))
; S resolves the app's cwd (dirfd-relative path resolution): the
; /proc/<pid>/cwd symlink carries the *app's* type, not proc_t
(allow wlsctx_t wlsctx_app_t (lnk_file (read)))
(allow wlsctx_t root_t (dir (getattr search)))
(allow wlsctx_t var_t (dir (search)))
(allow wlsctx_t var_run_t (dir (search)))
(allow wlsctx_t proc_t (dir (getattr search)))
(allow wlsctx_t proc_t (lnk_file (read)))
(allow wlsctx_t sysfs_t (dir (getattr search)))
(allow wlsctx_t etc_t (dir (getattr search)))
(allow wlsctx_t usr_t (dir (getattr open read search)))
(allow wlsctx_t bin_t (dir (getattr search)))
(allow wlsctx_t bin_t (file (entrypoint execute getattr map open read)))
(allow wlsctx_t bin_t (lnk_file (read)))
(allow wlsctx_t bin_t (process (noatsecure rlimitinh siginh)))
(allow wlsctx_t shell_exec_t (file (entrypoint execute execute_no_trans map open read)))
(allow wlsctx_t lib_t (dir (getattr search)))
(allow wlsctx_t lib_t (file (execute getattr map open read)))
(allow wlsctx_t lib_t (lnk_file (read)))
(allow wlsctx_t ld_so_t (file (execute map open read)))
(allow wlsctx_t ld_so_cache_t (file (getattr map open read)))
(allow wlsctx_t locale_t (dir (search)))
(allow wlsctx_t locale_t (file (getattr map open read)))
(allow wlsctx_t tmpfs_t (dir (add_name create getattr search setattr write)))
(allow wlsctx_t tmpfs_t (file (create mounton open write)))
(allow wlsctx_t tmpfs_t (lnk_file (create)))
(allow wlsctx_t home_root_t (dir (getattr open read search)))
(allow wlsctx_t user_home_dir_t (dir (getattr search)))
(allow wlsctx_t user_home_t (dir (getattr search)))
(allow wlsctx_t config_home_t (dir (getattr search)))
(allow wlsctx_t data_home_t (dir (getattr)))
(allow wlsctx_t cache_home_t (dir (getattr)))
(allow wlsctx_t gconf_home_t (dir (getattr search)))
; setattr: chmod of created dirs (mode 0700) and of the sockets
; (bind_listener sets 0600)
(allow wlsctx_t user_tmp_t (dir (create getattr open search read write add_name remove_name rmdir setattr)))
(allow wlsctx_t user_tmp_t (file (append create getattr ioctl open read write unlink)))
(allow wlsctx_t user_tmp_t (sock_file (create getattr open read write unlink setattr)))
(allow wlsctx_t user_tmp_t (unix_stream_socket (accept bind connectto create getattr read write getopt setopt)))
(allow wlsctx_t session_dbusd_tmp_t (sock_file (getattr open read write)))
(allow wlsctx_t unconfined_dbusd_t (unix_stream_socket (accept connectto getattr read write getopt setopt)))
(allow unconfined_dbusd_t wlsctx_t (unix_stream_socket (accept getattr read write)))
(allow wlsctx_t unconfined_dbusd_t (dbus (send_msg acquire_svc)))
(allow unconfined_dbusd_t wlsctx_t (dbus (send_msg)))
(allow wlsctx_t null_device_t (chr_file (open read write getattr ioctl)))
(allow wlsctx_t urandom_device_t (chr_file (open read write getattr)))
(allow wlsctx_t random_device_t (chr_file (getattr)))
(allow wlsctx_t zero_device_t (chr_file (getattr)))
(allow wlsctx_t ptmx_t (chr_file (open read write getattr)))
(allow wlsctx_t devtty_t (chr_file (open read write getattr)))
(allow wlsctx_t user_devpts_t (chr_file (ioctl read write)))
(allow wlsctx_t dri_device_t (chr_file (open read write getattr)))
(allow wlsctx_t device_t (dir (getattr open search read)))
(allow wlsctx_app_t wlsctx_app_t (process (fork getattr signal sigkill signull sigstop getsched getsession getrlimit setpgid setcurrent setexec setfscreate setkeycreate setsockcreate noatsecure rlimitinh siginh sigchld)))
(allow wlsctx_app_t wlsctx_app_t (dir (create getattr open search read write add_name remove_name rmdir)))
(allow wlsctx_app_t wlsctx_app_t (file (append create entrypoint execute execute_no_trans getattr map open read write unlink)))
; the app's *own* pipes (a shell pipeline `a | b`): sh `fstat`s the
; pipe ends (getattr), the writer writes, the reader reads — all
; against the fifo the creating process labeled wlsctx_app_t
; (the creator's type). Without this every intra-app pipeline is
; EACCES; mirror of the wlsctx_t self-fifo rule above.
(allow wlsctx_app_t wlsctx_app_t (fifo_file (read write getattr)))
; the app's shell (exec'd via /bin/sh or a subshell): entrypoint
; is the check of the *new* (exec-context) context at the wlsctx_t
; → wlsctx_app_t exec, execute_no_trans the same-type subshell
; execs, both against the file's shell_exec_t label
(allow wlsctx_app_t shell_exec_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow wlsctx_app_t wlsctx_t (dir (getattr open read search)))
(allow wlsctx_app_t wlsctx_t (file (getattr open read)))
(allow wlsctx_app_t wlsctx_t (sock_file (getattr open read)))
(allow wlsctx_app_t wlsctx_t (unix_stream_socket (accept connectto create getattr read write getopt setopt)))
(allow wlsctx_app_t wlsctx_t (fifo_file (read write)))
(allow wlsctx_app_t wlsctx_t (fd (use)))
(allow wlsctx_app_t unconfined_t (fd (use)))
(allow wlsctx_app_t unconfined_t (unix_stream_socket (read write)))
(allow wlsctx_app_t unconfined_t (fifo_file (read write ioctl)))
(allow wlsctx_app_t user_tmp_t (dir (create getattr open search read write add_name remove_name)))
; the isatty probe on a host-redirected stderr/stdout file (sh's
; TIOCGPGRP before it writes — harmless on a regular file, it just
; needs to be answerable)
(allow wlsctx_app_t user_tmp_t (file (append create getattr ioctl open read write unlink)))
(allow wlsctx_app_t user_tmp_t (sock_file (create getattr open read write)))
(allow wlsctx_app_t user_tmp_t (unix_stream_socket (accept bind connectto create getattr read write)))
; the sandbox's own /tmp is a fresh tmpfs: its mount root carries
; the unlabeled-mount default label tmpfs_t (filecons do not
; label fresh inodes on unlabeled mounts — the /tmp filecon
; labels the host's /tmp, which is tmp_t) — the app stats it and
; searches it on every cwd-relative access. The tmp_t rule covers
; a host /tmp bind-mounted in by a profile (a bind carries the
; inode's tmp_t SID with it).
(allow wlsctx_app_t tmp_t (dir (getattr search)))
(allow wlsctx_app_t tmpfs_t (dir (getattr open search read)))
(allow wlsctx_app_t tmpfs_t (file (append create getattr map open read write unlink)))
(allow wlsctx_app_t session_dbusd_tmp_t (sock_file (getattr open read write)))
(allow wlsctx_app_t unconfined_dbusd_t (unix_stream_socket (accept connectto getattr read write getopt setopt)))
(allow unconfined_dbusd_t wlsctx_app_t (unix_stream_socket (accept getattr read write)))
(allow wlsctx_app_t unconfined_dbusd_t (dbus (send_msg)))
(allow unconfined_dbusd_t wlsctx_app_t (dbus (send_msg)))
(allow wlsctx_app_t unconfined_t (dbus (send_msg)))
(allow wlsctx_app_t node_t (node (recvfrom sendto tcp_recv tcp_send udp_recv udp_send)))
; the app's own unix sockets (socketpairs, local listeners):
; same socket-class self-permissions as its tcp/udp rule set
(allow wlsctx_app_t wlsctx_app_t (unix_stream_socket (accept bind connect connectto create getattr read write getopt setopt listen)))
(allow wlsctx_app_t wlsctx_app_t (tcp_socket (create getattr name_bind connect read write getopt setopt)))
(allow wlsctx_app_t wlsctx_app_t (udp_socket (create getattr name_bind connect read write getopt setopt)))
(allow wlsctx_app_t null_device_t (chr_file (open read write getattr ioctl)))
(allow wlsctx_app_t urandom_device_t (chr_file (open read write getattr ioctl)))
(allow wlsctx_app_t random_device_t (chr_file (getattr)))
(allow wlsctx_app_t zero_device_t (chr_file (getattr)))
(allow wlsctx_app_t ptmx_t (chr_file (open read write getattr ioctl)))
(allow wlsctx_app_t devtty_t (chr_file (open read write getattr ioctl)))
(allow wlsctx_app_t user_devpts_t (chr_file (read write)))
(allow wlsctx_app_t dri_device_t (chr_file (open read write getattr)))
(allow wlsctx_app_t proc_t (dir (getattr search)))
(allow wlsctx_app_t proc_t (file (getattr open read)))
(allow wlsctx_app_t proc_t (lnk_file (read)))
(allow wlsctx_app_t security_t (filesystem (getattr)))
(allow wlsctx_app_t sysfs_t (dir (getattr search)))
(allow wlsctx_app_t sysfs_t (file (getattr open read)))
(allow wlsctx_app_t var_run_t (dir (getattr search)))
(allow wlsctx_app_t selinux_config_t (dir (getattr search)))
(allow wlsctx_app_t selinux_config_t (file (getattr open read)))
(allow wlsctx_app_t cgroup_t (dir (getattr open search read)))
(allow wlsctx_app_t cgroup_t (file (getattr open read)))
(allow wlsctx_app_t etc_t (dir (getattr open search read)))
(allow wlsctx_app_t etc_t (file (getattr open read)))
(allow wlsctx_app_t root_t (dir (search)))
(allow wlsctx_app_t home_root_t (dir (getattr open read search)))
(allow wlsctx_app_t user_home_dir_t (dir (getattr open search read)))
(allow wlsctx_app_t user_home_t (dir (create getattr open search read write add_name remove_name)))
(allow wlsctx_app_t cache_home_t (dir (create getattr open search read write add_name remove_name)))
(allow wlsctx_app_t config_home_t (dir (create getattr open search read write add_name remove_name)))
(allow wlsctx_app_t data_home_t (dir (create getattr open search read write add_name remove_name)))
(allow wlsctx_app_t gconf_home_t (dir (create getattr open search read write add_name remove_name)))
(allow wlsctx_app_t user_home_t (file (append create entrypoint execute execute_no_trans getattr map open read write unlink)))
(allow wlsctx_app_t cache_home_t (file (append create getattr map open read write unlink)))
(allow wlsctx_app_t config_home_t (file (append create getattr map open read write unlink)))
(allow wlsctx_app_t data_home_t (file (append create getattr map open read write unlink)))
(allow wlsctx_app_t gconf_home_t (file (append create getattr map open read write unlink)))
(allow wlsctx_app_t bin_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow wlsctx_app_t lib_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow wlsctx_app_t usr_t (file (entrypoint execute execute_no_trans getattr map open read)))
; the app resolves and stats the system trees it execs from
; (path lookup = search on every dir of the path; stat = getattr;
; symlinked components = lnk_file read — without these even
; `stat /` and PATH lookup fail):
(allow wlsctx_app_t bin_t (dir (getattr search)))
(allow wlsctx_app_t bin_t (lnk_file (read)))
(allow wlsctx_app_t usr_t (dir (getattr search)))
(allow wlsctx_app_t usr_t (lnk_file (read)))
(allow wlsctx_app_t lib_t (lnk_file (read)))
(allow wlsctx_app_t etc_t (lnk_file (read)))
(allow wlsctx_app_t root_t (dir (getattr search)))
; glibc/bash NSS lookups (getpwuid): /etc/passwd
(allow wlsctx_app_t passwd_file_t (file (getattr open read)))
; fstat on the host-created stdio pipes inherited into the sandbox
(allow wlsctx_app_t unconfined_t (fifo_file (getattr)))
; the dynamic linker itself: open (its fstat) plus execute/map/read
(allow wlsctx_app_t ld_so_t (file (execute map open read getattr)))
(allow wlsctx_app_t ld_so_cache_t (file (getattr map open read)))
(allow wlsctx_app_t locale_t (dir (search)))
(allow wlsctx_app_t locale_t (file (getattr map open read)))
; ls formatting mtimes: tzset reads /etc/localtime, a symlink
; (labeled locale_t, not etc_t) into the zoneinfo tree
(allow wlsctx_app_t locale_t (lnk_file (read)))
(allow wlsctx_app_t lib_t (dir (search)))
(allow wlsctx_app_t lib_t (lnk_file (read)))
(allow wlsctx_app_t usr_t (dir (search)))
(allow wlsctx_app_t xserver_t (unix_stream_socket (connectto read write)))
(allow xserver_t wlsctx_app_t (unix_stream_socket (read write)))
(allow xserver_t user_tmp_t (file (getattr open read)))
(allow xserver_t user_tmp_t (sock_file (getattr open read)))
(allow xserver_t user_tmp_t (unix_stream_socket (accept getattr read write)))
; Xwayland binds and listens its own X socket (the satellite
; hands a listening fd over to the compositor)
(allow xserver_t xserver_t (unix_stream_socket (accept bind connect create getattr read write listen)))
; systemd (init_t) does cgroup bookkeeping on the per-instance
; sub-cgroup directories (created by wlsctx, so they carry the
; process contexts, not cgroup_t)
(allow init_t wlsctx_t (dir (getattr read search)))
(allow init_t wlsctx_t (file (getattr ioctl open read)))
(allow init_t wlsctx_app_t (dir (getattr read search)))
(allow init_t wlsctx_app_t (file (getattr ioctl open read)))
(filecon "/usr/local/bin/wlsctx" file (system_u object_r wlsctx_exec_t ((s0) (s0))))
(filecon "/usr/bin/wlsctx" file (system_u object_r wlsctx_exec_t ((s0) (s0))))
