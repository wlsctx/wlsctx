ARG JB_PRODUCTS_URL=https://data.services.jetbrains.com/products
ARG JB_CODE
ARG JB_RELEASE_TYPE=release

FROM runtime AS base
RUN --mount=type=cache,id=dnf5-fedora,dst=/var/cache/libdnf5 \
  set -eufx; \
  dnf install -y --setopt=install_weak_deps=false \
    --setopt=keepcache=true \
    jq \
    curl \
    coreutils \
    gnupg2 \
    ;

FROM scratch AS jb-keys
# Checksum-pinned copy of JetBrains' KEYS file (the public keys they sign
# release checksums with). Update this checksum (and re-verify the build)
# when JetBrains re-publishes KEYS.
#
# NOTE: the older in-repo inline copy of this key expired 2026-03-15 and
# has been removed; the downloaded, pinned file is the single source of
# key material.
ADD --checksum=sha256:665f0d69a36de15b60e93601f8df1ce1edf0ad4f9e0041d0d977b41fcdc6f006 \
  https://download.jetbrains.com/KEYS /KEYS

FROM scratch AS jb-product-desc
ARG JB_PRODUCTS_URL
ARG JB_CODE
ADD "${JB_PRODUCTS_URL}?code=${JB_CODE}&fields=code,name,productFamilyName,intellijProductCode,description" /product-desc.json

FROM scratch AS jb-latest-release
ARG JB_PRODUCTS_URL
ARG JB_CODE
ARG JB_RELEASE_TYPE
ADD "${JB_PRODUCTS_URL}/releases?code=${JB_CODE}&type=${JB_RELEASE_TYPE}&latest=true" /release.json

FROM base AS download
ARG TARGETOS
ARG TARGETARCH
WORKDIR /work
COPY --from=jb-product-desc /product-desc.json /product-desc.json
COPY --from=jb-latest-release /release.json /release.json
# The (checksum-pinned) JetBrains KEYS file, for verifying the .sha256.asc
# signature of the release checksum.
COPY --from=jb-keys /KEYS /KEYS
# TODO: the .sha256.asc signature chain could not be exercised at the time
# this was written (JetBrains' releases API returned empty responses from
# the authoring environment). Run one build of this image and confirm the
# gpg --verify step passes; if JetBrains changed their signing, refresh
# the KEYS checksum above.
RUN --mount=type=cache,id=download-jb,dst=/download \
  set -eufx; \
  [ "${TARGETARCH}" == "arm64" ] && \
    plat="${TARGETOS}ARM64" || plat="${TARGETOS}"; \
  prod=$(jq -j '.[].name' /product-desc.json | \
    tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9+@_-') && \
  [ -n "${prod}" ]; \
  filename=$(jq -j --arg plat "${plat}" \
    '.[][].downloads[$plat].link / "/" | last' /release.json) && \
  [ -n "${filename}" ]; \
  sha256filename=$(jq -j --arg plat "${plat}" \
    '.[][].downloads[$plat].checksumLink / "/" | last' /release.json) && \
  [ -n "${sha256filename}" ]; \
  # Import KEYS into an isolated keyring. The file's content is pinned by
  # the ADD checksum above, so a valid signature against it means the
  # checksum file (and through it the tarball) is genuine.
  gpg --batch --homedir /gphome --import /KEYS; \
  if [ -f "/download/${sha256filename}" ] &&  \
    [ -f "/download/${filename}" ] && \
    [ -f "/download/${sha256filename}.asc" ] && \
    gpg --batch --homedir /gphome --verify "/download/${sha256filename}.asc" "/download/${sha256filename}" && \
    ( cd "/download" && sha256sum -c "./${sha256filename}" ); then \
    printf 'Already downloaded: %s\n' "${filename}"; \
  else \
    jq -r --arg plat "${plat}" \
      '.[][].downloads[$plat] | (.link, .checksumLink, .checksumLink + ".asc")' \
      /release.json | \
    curl --retry 5 --remove-on-error --remote-name-all -Lf --parallel --url @- && \
    gpg --batch --homedir /gphome --verify "./${sha256filename}.asc" "./${sha256filename}" && \
    sha256sum -c "./${sha256filename}" && \
    mv -t "/download/" "./${filename}" "./${sha256filename}" "./${sha256filename}.asc"; \
  fi; \
  mkdir -p "/out/jetbrains/bin" "/out/${prod}" && \
  tar -C "/out/${prod}" --strip-components=1 -xf "/download/${filename}" && \
  launcher=$(jq -r '.launch[].launcherPath' "/out/${prod}/product-info.json") && \
  ln -svr "/out/${prod}/${launcher}" "/out/jetbrains/bin/" && \
  find "/out/${prod}/bin/" -maxdepth 1 -name '*.vmoptions' \
    -execdir sed -i -e '$a-Dawt.toolkit.name=WLToolkit' '{}' + && \
  :
FROM scratch AS ide-files
COPY --from=download /out/ /

FROM runtime AS merge
COPY --link --from=ide-files / /opt/
ENV PATH=/opt/jetbrains/bin:${PATH}
