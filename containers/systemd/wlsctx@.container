# Deployment mode A (of two): standalone, systemd socket-activated wlsctx.
#
# wlsctx@%i.socket owns $XDG_RUNTIME_DIR/wlsctx/%i/wayland-1 and
# socket-activates this container; wlsctx receives the listening socket
# via LISTEN_FDS and tags it with the explicit --app-id/--instance-id
# (WLSCTX_APP_ID / WLSCTX_INSTANCE_ID must be set — see the [Container]
# section). The tagged socket lives in the host's XDG_RUNTIME_DIR, so
# whatever connects to it (pod or bare host process) needs access to that
# path.
#
# Deployment mode B: the wl-display@ in-pod sidecar (see
# wl-display@.container) — it runs inside each app's pod and tags the
# socket at $POD_RUNTIME_DIR/wayland-1 inside the pod instead.
[Unit]
Description=Minimal Wayland security context manager
BindsTo=wlsctx@%i.socket
After=wlsctx@%i.socket

[Quadlet]
DefaultDependencies=false

[Container]
Image=wlsctx.image
Exec=--socket-activation
Environment=WLSCTX_SANDBOX_ENGINE=${WLSCTX_SANDBOX_ENGINE}
# --socket-activation requires explicit WLSCTX_APP_ID / WLSCTX_INSTANCE_ID
# (the binary no longer derives them from LISTEN_FDNAMES; the socket unit
# sets FileDescriptorName=%i, which normally contains no '@'). Pass them
# through only if set; if missing, the binary fails with a clear
# "required argument" error instead of running with empty IDs. Set them
# in an environment.d file or a drop-in before starting wlsctx@<instance>.
Environment=WLSCTX_APP_ID
Environment=WLSCTX_INSTANCE_ID
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}
Environment=RUST_LOG=debug
Pull=never
Network=none
Notify=true
NoNewPrivileges=true
UserNS=keep-id
User=%U
Group=%G
ReadOnly=true
DropCapability=ALL
Memory=128m
Label=io.ghcr/wlsctx/instance=%i
Mount=type=bind,ro,source=%t/${WAYLAND_DISPLAY},destination=%t/wayland-1
ContainerName=systemd-wlsctx_${INVOCATION_ID}
#SecurityLabelDisable=true
SecurityLabelType=wlsctx.process

[Service]
Restart=always
Environment=WLSCTX_SANDBOX_ENGINE=podman
