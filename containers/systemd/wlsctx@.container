# Deployment mode A (of two): standalone, systemd socket-activated wlsctx,
# running the transparent relay by default.
#
# wlsctx@%i.socket owns $XDG_RUNTIME_DIR/wlsctx/%i/wayland-1 (now the
# relay's PUBLIC socket) and socket-activates this container; wlsctx
# receives it via LISTEN_FDS and relays every connection over the
# tagged socket it binds ITSELF at %t/wlsctx-tagged — inside this
# container's private runtime dir (the container's XDG_RUNTIME_DIR is
# the host's value, but its /run is its own filesystem, so the tagged
# socket is unreachable from anything that connects to the public
# one). The relay applies the same optional policies as mode B:
# WLSCTX_ALLOW_GLOBALS (allowlist) and WLSCTX_CLIPBOARD_POLICY=deny
# (the clipboard/primary-selection receive-gate); set them in a
# drop-in with Environment= lines in both [Service] and [Container].
# WLSCTX_APP_ID / WLSCTX_INSTANCE_ID must be set (see the [Container]
# section).
#
# To run the original tag-and-park behaviour instead (the socket
# itself is the tagged one, no relay, no interception): remove
# --proxy --tagged-socket=... from Exec.
#
# The relay's selection audit log (Phase 9) is written to its stderr
# (the `audit` log target); with LogDriver=passthrough (below) and
# StandardError=journal it lands in the HOST journal like mode B's
# (journalctl -u wlsctx@%i, greppable on the key=value fields).
# RUST_LOG=warn (instead of the default debug) silences the stream.
#
# Optional prompt broker: as in mode B, bind the host's
# wlsctx-broker socket into this container's private /run and point
# the relay at it (a missing or slow broker fails closed — the read
# is dropped). The same socket also carries the Phase 6 copy-out
# notification (add Environment=WLSCTX_NOTIFY_COPY_OUT=true to the
# drop-in: a desktop notification on each app write to the clipboard
# or primary selection; independent of the gate's policy, fails open):
#   [Service]
#   Environment=WLSCTX_BROKER_SOCKET=/run/broker.sock
#   [Container]
#   Mount=type=bind,source=%t/wlsctx-broker,destination=/run/broker.sock
#
# Deployment mode B: the wl-display@ in-pod sidecar (see
# wl-display@.container) — it runs inside each app's pod and serves
# the relay's public socket at $POD_RUNTIME_DIR/wayland-1 inside the
# pod instead.
[Unit]
Description=Minimal Wayland security context manager
BindsTo=wlsctx@%i.socket
After=wlsctx@%i.socket

[Quadlet]
DefaultDependencies=false

[Container]
Image=wlsctx.image
Exec=--socket-activation --proxy --tagged-socket=%t/wlsctx-tagged
Environment=WLSCTX_SANDBOX_ENGINE=${WLSCTX_SANDBOX_ENGINE}
# --socket-activation requires explicit WLSCTX_APP_ID / WLSCTX_INSTANCE_ID
# (the binary no longer derives them from LISTEN_FDNAMES; the socket unit
# sets FileDescriptorName=%i, which normally contains no '@'). Pass them
# through only if set; if missing, the binary fails with a clear
# "required argument" error instead of running with empty IDs. Set them
# in an environment.d file or a drop-in before starting wlsctx@<instance>.
Environment=WLSCTX_APP_ID
Environment=WLSCTX_INSTANCE_ID
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}
Environment=RUST_LOG=debug
Pull=never
Network=none
Notify=true
NoNewPrivileges=true
UserNS=keep-id
User=%U
Group=%G
ReadOnly=true
DropCapability=ALL
Memory=128m
Label=io.ghcr/wlsctx/instance=%i
Mount=type=bind,ro,source=%t/${WAYLAND_DISPLAY},destination=%t/wayland-1
ContainerName=systemd-wlsctx_${INVOCATION_ID}
#SecurityLabelDisable=true
SecurityLabelType=wlsctx.process
# The audit log (and the rest of the relay's logging) is on the
# container's stderr; passthrough keeps it out of any container-local
# log file so the host journal gets it directly.
LogDriver=passthrough

[Service]
Restart=always
Environment=WLSCTX_SANDBOX_ENGINE=podman
# Host journal for the relay's stderr (the Phase 9 audit records;
# same arrangement as mode B's wl-display@ sidecar).
StandardOutput=journal
StandardError=journal
