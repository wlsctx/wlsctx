# Deployment mode B (of two): wlsctx as an in-pod sidecar.
#
# Unlike the standalone wlsctx@ (mode A, systemd socket-activated with the
# socket in the host's XDG_RUNTIME_DIR), this container runs inside each
# app's pod and serves $POD_RUNTIME_DIR/wayland-1 (/run/pod/wayland-1)
# inside the pod, so every app in the pod gets a relayed (and
# context-stamped) connection with no host-side path access at all. The host's Wayland socket is passed
# in as the container's own stdin (see the [Service] comment below) —
# no extra privileges or SELinux label needed for the socket itself.
#
# The sidecar runs the transparent Wayland PROXY (--proxy): apps talk to
# the public socket above, and the proxy relays to the compositor over
# the tagged socket at $POD_RUNTIME_DIR/wlsctx-tagged (bound here,
# stamped by the compositor during the security-context handshake, and
# connected to by the proxy only). The relay enforces the protocol
# bookkeeping the interception phases build on (global allowlist,
# clipboard gating, …). To fall back to plain tag-and-park (apps talk
# to the compositor directly, no relay), remove the --proxy and
# --tagged-socket arguments from Exec below.
#
# Optional global allowlist: set WLSCTX_ALLOW_GLOBALS (comma-separated
# interface names, e.g. "wl_compositor,wl_shm") to hide every other
# global from the sandboxed apps; binds of hidden globals are rejected
# with a fatal wl_display.error. Not set by default: hiding
# wl_data_device_manager would break the clipboard outright, and the
# intended clipboard protection is the finer-grained receive-gate,
# which still allows binding.
#
# Optional clipboard receive-gate: set WLSCTX_CLIPBOARD_POLICY=deny
# (default: allow) to stop sandboxed apps from reading selections
# owned by sources they never created — i.e. data copied on the host
# desktop. The gate covers both the clipboard (wl_data_device) and
# the primary selection (wp_primary_selection_unstable_v1, the
# X-style middle-click paste): a foreign read of either is consumed
# silently, the app's fd stays empty and it sees an empty selection
# rather than the data. Reads of the app's own selections are
# unaffected. The value reaches the wlsctx process through the
# container environment, so a drop-in that sets it should add
# Environment= lines to both [Service] and [Container].
#
# Optional prompt broker (phase 4): with the gate in deny, dropped
# foreign reads (of either selection) can be *asked about* instead
# of silently lost — the
# sidecar's proxy connects to the host-side broker (the
# wlsctx-broker.socket / wlsctx-broker.service units, which notify
# the user and wait for `wlsctx --decide`) and, on an allow, opens
# the gate's 1500 ms intent window. Wire it with a drop-in that
# bind-mounts the broker's host socket into THIS container's private
# /run (not into the shared /run/pod volume, so no app in the pod
# can reach it) and points the proxy at it:
#   [Service]
#   Environment=WLSCTX_BROKER_SOCKET=/run/broker.sock
#   [Container]
#   Mount=type=bind,source=%t/wlsctx-broker,destination=/run/broker.sock
# The mount is only visible to this sidecar (each container gets its
# own private %t tmpfs); the proxy's asks still fail closed if the
# broker is stopped, so this is strictly opt-in.
[Unit]
Description=Minimal Wayland security context manager
StopWhenUnneeded=yes

[Service]
Environment=WLSCTX_SANDBOX_ENGINE=podman
Environment=WLSCTX_APP_ID=pod
Environment=WLSCTX_INSTANCE_ID=%i
# We pass the connected Wayland socket via stdin instead of having to give the wlsctx container any extra privileges or SELinux label.
# Unfortunately, StandardInput=/StandardOutput= do not support environment variables, so we can't use ${WAYLAND_DISPLAY} here.
StandardInput=file:%t/wayland-1
# NOT file:%t/wayland-1: opening the host Wayland socket as an output fd
# creates a second, untagged connection to the compositor — anything the
# process (or a child inheriting fd 1) writes to stdout would be injected
# into the compositor as raw Wayland protocol data, outside the security
# context.
StandardOutput=journal
StandardError=journal

[Container]
LogDriver=passthrough
Environment=WAYLAND_SOCKET=0
Exec=--listen=${POD_RUNTIME_DIR}/${WAYLAND_DISPLAY} --proxy --tagged-socket=${POD_RUNTIME_DIR}/wlsctx-tagged
Image=wlsctx.image
Pull=never
Environment=WLSCTX_SANDBOX_ENGINE=${WLSCTX_SANDBOX_ENGINE}
Environment=WLSCTX_APP_ID=${WLSCTX_APP_ID}
Environment=WLSCTX_INSTANCE_ID=${WLSCTX_INSTANCE_ID}
Environment=RUST_LOG=info
Network=none
Notify=true
NoNewPrivileges=true
DropCapability=ALL
Memory=128m
User=%U
Group=%G
WorkingDir=/
